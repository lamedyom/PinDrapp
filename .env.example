VITE_MAPBOX_TOKEN=your_mapbox_token_here
VITE_STRIPE_PUBLISHABLE_KEY=your_stripe_key_here
VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name_here
VITE_CLOUDINARY_UPLOAD_PRESET=pindrapp_videos

# Supabase auth + DB (leave blank to disable auth and run on mock data)
VITE_SUPABASE_URL=your_supabase_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Override the OAuth redirect URL. Defaults to the production URL
# (https://pindrapp.onrender.com/auth/callback) — set this to
# http://localhost:5173/auth/callback for local development so OAuth
# redirects back to your dev server instead of prod.
VITE_AUTH_REDIRECT_URL=

# Base URL of the Pindrapp API server (server/). Leave blank to run the AI
# Autopilot and Pro trial in offline demo mode (mock suggestions). For local
# dev with the API running, set http://localhost:3001.
VITE_API_URL=

# ── Server (server/.env) — never expose these to the client ────────────────
# SUPABASE_URL=your_supabase_url
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key   # server-side writes (bypasses RLS)
# ANTHROPIC_API_KEY=your_anthropic_key              # console.anthropic.com — AI Autopilot copy
# REPLICATE_API_TOKEN=your_replicate_token          # replicate.com/account — deal image generation
# STRIPE_PRO_PRICE_ID=price_xxx                      # $29/mo recurring price for Pindrapp Pro
# STRIPE_WEBHOOK_SECRET=whsec_xxx                    # Stripe CLI / dashboard webhook signing secret
# CLIENT_ORIGIN=http://localhost:5173
